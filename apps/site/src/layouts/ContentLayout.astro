---
import BaseLayout from './BaseLayout.astro';
import { render, type CollectionEntry } from 'astro:content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

type SidebarItem = {
  href: string;
  label: string;
  badge?: string;
};

type Props = {
  title: string;
  description?: string;
  entry: CollectionEntry<'docs'> | CollectionEntry<'legal'>;
  sidebar?: SidebarItem[];
  legal?: boolean;
};

const { title, description, entry, sidebar, legal } = Astro.props;
const { Content } = await render(entry);
const currentPath = Astro.url.pathname;
const hasSidebar = sidebar !== undefined && sidebar.length > 0;
const isPT = currentPath.startsWith('/docs/pt/') || currentPath === '/docs/pt';
const layoutMax = hasSidebar ? '1440px' : legal ? '800px' : '860px';
---
<BaseLayout title={title} description={description}>
  <Nav lang={isPT ? 'pt' : undefined} />
  <div class="layout" style={`max-width: ${layoutMax}`}>
    {sidebar && (
    <aside class="sidebar">
      <nav>
        <a href={isPT ? '/docs/pt' : '/docs'} class="sidebar-header">{isPT ? 'Documentação' : 'Documentation'}</a>
        <ul class="sidebar-list">
          {sidebar.map((item: SidebarItem) => {
            const isActive = currentPath === item.href;
            return (
              <li>
                <a href={item.href} class={`sidebar-item${isActive ? ' active' : ''}`}>
                  {item.label}
                  {item.badge && <span class="badge">{item.badge}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>
    )}
    <main class="content" class:list={{ 'content--with-sidebar': hasSidebar }}>
      {legal && <div class="legal-marker" aria-hidden="true"></div>}
      <h1 class="h1">{title}</h1>
      <article class="article article--legal">
        <Content />
      </article>
    </main>
  </div>
  <Footer />
</BaseLayout>

<style>
  .layout {
    display: flex;
    margin: 0 auto;
    padding: 3rem 0;
    min-height: calc(100vh - 200px);
    gap: 3rem;
  }

  .sidebar {
    flex: 0 0 200px;
    position: sticky;
    top: 80px;
    align-self: flex-start;
  }

  .sidebar-header {
    display: block;
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 1.25rem;
    padding: 0 0.5rem;
  }

  .sidebar-header:hover { color: var(--accent); }

  .sidebar-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .sidebar-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    margin: 0 0.25rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }

  .sidebar-item:hover { background: var(--bg-subtle); color: var(--text); }
  .sidebar-item.active { color: var(--accent); background: var(--bg-subtle); font-weight: 500; }
  .badge { font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; padding: 0.125rem 0.35rem; border-radius: 4px; background: var(--bg-subtle); color: var(--faint); border: 1px solid var(--border); }

  .content { flex: 1; min-width: 0; position: relative; }

  .content--with-sidebar {
    padding-right: clamp(0.75rem, 2vw, 1.5rem);
  }

  .legal-marker {
    display: block;
    position: absolute;
    top: 0;
    left: -2.5rem;
    width: 3px;
    height: 3rem;
    background: var(--accent);
    border-radius: 2px;
  }

  .h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 500;
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 100;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .article {
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .article--legal {
    font-size: 0.9375rem;
    line-height: 1.85;
    color: var(--muted);
  }

  .article h2, .article--legal h2 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text);
    margin: 2.5rem 0 0.75rem;
    line-height: 1.3;
    padding-top: 0.5rem;
  }

  .article h3 {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.5rem 0 0.5rem;
  }

  .article p { margin-bottom: 1rem; }
  .article--legal p { margin-bottom: 1.125rem; }

  .article ul, .article ol {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .article li { margin-bottom: 0.35rem; }
  .article--legal li { margin-bottom: 0.5rem; }

  /* FAQ accordion */
  .faq-q {
    border-top: 1px solid var(--border);
    cursor: pointer;
  }

  .faq-q:last-of-type {
    border-bottom: 1px solid var(--border);
  }

  .faq-q summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.125rem 0;
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 400;
    color: var(--text);
    cursor: pointer;
    list-style: none;
    user-select: none;
    transition: color 0.2s;
  }

  .faq-q summary::-webkit-details-marker { display: none; }
  .faq-q summary:hover { color: var(--accent); }

  .faq-q summary::after {
    content: '+';
    font-family: var(--sans);
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--faint);
    flex-shrink: 0;
    line-height: 1;
    transition: transform 0.35s var(--ease-out), color 0.2s;
  }

  .faq-q[open] summary::after {
    transform: rotate(45deg);
    color: var(--accent);
  }

  .faq-q[open] summary {
    color: var(--accent);
  }

  .faq-q p, .faq-q ul, .faq-q ol {
    padding-bottom: 1.25rem;
    margin-bottom: 0;
  }

  .faq-q ul, .faq-q ol {
    padding-top: 0.25rem;
  }

  /* Callout boxes */
  .callout {
    background: var(--bg-subtle);
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.6;
  }

  .callout strong {
    color: var(--text);
  }

  /* Step lists */
  .article ol li::marker {
    color: var(--accent);
    font-weight: 500;
  }

  .article a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: opacity 0.15s;
  }

  .article a:hover { opacity: 0.7; }

  .article strong { color: var(--text); font-weight: 500; }

  .article hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5rem 0;
  }

  .article--legal hr {
    margin: 3rem 0;
  }

  .article code {
    background: var(--bg-subtle);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--text);
  }

  .article pre {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  .article pre code { background: none; padding: 0; color: inherit; }

  .article table { width: 100%; border-collapse: collapse; margin-bottom: 1.5rem; font-size: 0.875rem; }
  .article th, .article td { padding: 0.625rem 0.75rem; text-align: left; border-bottom: 1px solid var(--border); line-height: 1.5; }
  .article th { font-weight: 500; color: var(--text); font-size: 0.8125rem; letter-spacing: 0.02em; }

  @media (max-width: 768px) {
    .layout { flex-direction: column; gap: 1.5rem; padding-top: 2rem; padding-left: clamp(0.75rem, 2vw, 1.5rem); padding-right: clamp(0.75rem, 2vw, 1.5rem); }
    .sidebar { flex: none; position: static; }
    .sidebar-list { flex-direction: row; flex-wrap: wrap; gap: 0.25rem; }
    .sidebar-item { font-size: 0.8125rem; padding: 0.3rem 0.5rem; margin: 0; }
    .content--with-sidebar { padding-right: 0; }
    .legal-marker { display: none; }
  }
</style>
