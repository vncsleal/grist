---
import BaseLayout from './BaseLayout.astro';
import { render } from 'astro:content';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const { title, description } = Astro.props;
const { Content } = await render(Astro.props.entry);

// Sidebar items — defined here so it's easy to maintain
const sidebarItems = [
  { href: "/docs/instalar", label: "Instalar" },
  { href: "/docs/primeiros-passos", label: "Primeiros passos" },
  { href: "/docs/clientes", label: "Clientes" },
  { href: "/docs/faq", label: "FAQ" },
  { href: "/docs/cloud", label: "Cloud", badge: "Em breve" },
];
const currentPath = Astro.url.pathname;
---
<BaseLayout title={title} description={description}>
  <Nav />
  <div class="doc-shell">
    <aside class="doc-sidebar">
      <nav>
        <a href="/docs" class="sidebar-header">Documentação</a>
        <ul class="sidebar-list">
          {sidebarItems.map(item => {
            const isActive = currentPath === item.href ||
              (item.href === "/docs" && currentPath === "/docs");
            return (
              <li>
                <a
                  href={item.href}
                  class={`sidebar-link${isActive ? ' active' : ''}`}
                >
                  {item.label}
                  {item.badge && <span class="sidebar-badge">{item.badge}</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    </aside>
    <main class="doc-content">
      <h1 class="doc-title">{title}</h1>
      <article class="doc-article">
        <Content />
      </article>
    </main>
  </div>
  <Footer />
</BaseLayout>

<style>
  .doc-shell {
    position: relative; z-index: 1;
    display: flex;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem clamp(1.5rem, 5vw, 5rem);
    min-height: calc(100vh - 200px);
    gap: 3rem;
  }

  .doc-sidebar {
    flex: 0 0 220px;
    position: sticky; top: 80px;
    align-self: flex-start;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }

  .sidebar-header {
    display: block;
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    margin-bottom: 1.5rem;
  }
  .sidebar-header:hover { color: var(--accent); }

  .sidebar-list { list-style: none; display: flex; flex-direction: column; gap: 0.35rem; }

  .sidebar-link {
    display: flex; align-items: center; gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    padding: 0.45rem 0.75rem;
    border-radius: 6px;
    transition: background 0.15s, color 0.15s;
  }
  .sidebar-link:hover { background: var(--surface-h); color: var(--text); }
  .sidebar-link.active {
    color: var(--accent);
    background: rgba(251,244,220,0.06);
    font-weight: 600;
  }

  .sidebar-badge {
    font-family: var(--mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    background: rgba(106,70,144,0.25);
    color: var(--purple-pale);
    border: 1px solid var(--border);
  }

  .doc-content {
    flex: 1;
    min-width: 0;
  }

  .doc-title {
    font-family: var(--serif);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 2rem;
    line-height: 1.1;
  }

  .doc-article {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--muted);
  }

  .doc-article h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin: 2.5rem 0 0.75rem;
  }
  .doc-article h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin: 1.5rem 0 0.5rem;
  }
  .doc-article p { margin-bottom: 1rem; }
  .doc-article ul, .doc-article ol { padding-left: 1.5rem; margin-bottom: 1rem; }
  .doc-article li { margin-bottom: 0.35rem; }
  .doc-article a { color: var(--accent); }

  .doc-article code {
    background: var(--bg-2);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-family: var(--mono);
    font-size: 0.875rem;
    color: var(--purple-pale);
  }
  .doc-article pre {
    background: var(--bg-2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }
  .doc-article pre code {
    background: none;
    padding: 0;
    color: inherit;
  }

  @media (max-width: 768px) {
    .doc-shell {
      flex-direction: column;
      gap: 1rem;
    }
    .doc-sidebar {
      flex: none;
      position: static;
      max-height: none;
      overflow: visible;
    }
    .sidebar-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem;
    }
    .sidebar-link { font-size: 0.8125rem; padding: 0.35rem 0.6rem; }
    .doc-title { font-size: 1.75rem; }
  }
</style>
