---
import '../styles/global.css';
import { useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { type Lang } from '../i18n/ui';
const { title, description, ogImage, lang } = Astro.props as {
  title: string;
  description: string;
  ogImage?: string;
  lang: Lang;
};
const origin = Astro.url.origin;
const t = useTranslations(lang);
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/quillby.png" type="image/png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage ? new URL(ogImage, origin).href : `${origin}/og.png`} />
    <meta property="og:url" content={origin + Astro.url.pathname} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage ? new URL(ogImage, origin).href : `${origin}/og.png`} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#5c3a7e" />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="a64b34a7-ab65-42c8-8120-99de9bdf6d85"></script>
    <slot name="head" />
  </head>
  <body>
    <slot />
    <aside class="cookie-notice" data-cookie-notice hidden>
      <p>
        {t('cookie.text')}
        {' '}
        <a href={getRelativeLocaleUrl(lang, 'legal/privacy')}>{t('cookie.link')}</a>.
      </p>
      <button data-cookie-dismiss>
        {t('cookie.dismiss')}
      </button>
    </aside>
  </body>
</html>

<style>
  .cookie-notice {
    position: fixed;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 300;
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.08);
    max-width: min(90vw, 520px);
    font-size: 0.8125rem;
    color: var(--text-2);
    line-height: 1.5;
  }

  .cookie-notice p {
    margin: 0;
    flex: 1;
  }

  .cookie-notice a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .cookie-notice button {
    flex-shrink: 0;
    padding: 0.35rem 0.85rem;
    border: none;
    border-radius: 8px;
    background: var(--accent);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s;
    white-space: nowrap;
  }

  .cookie-notice button:hover {
    background: var(--accent-h);
  }

  @media (max-width: 480px) {
    .cookie-notice {
      flex-direction: column;
      text-align: center;
      bottom: 0.75rem;
      padding: 0.75rem 1rem;
    }
    .cookie-notice button {
      width: 100%;
    }
  }
</style>

<script>
  (function() {
    const notice = document.querySelector('[data-cookie-notice]');
    const dismissBtn = document.querySelector('[data-cookie-dismiss]');
    if (notice && dismissBtn) {
      if (!document.cookie.includes('quillby-cookie-dismissed')) {
        notice.removeAttribute('hidden');
      }
      dismissBtn.addEventListener('click', () => {
        document.cookie = 'quillby-cookie-dismissed=1; path=/; max-age=' + (60 * 60 * 24 * 365);
        notice.setAttribute('hidden', '');
      });
    }
  })();
</script>
