---
import '../styles/global.css';
const { title, description, ogImage } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/quillby.png" type="image/png" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ?? "Quillby — Your AI Content Agent"}</title>
    <meta name="description" content={description ?? "Quillby scans the internet for content relevant to your niche, delivers a curated brief, and writes drafts in your voice."} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title ?? "Quillby — Your AI Content Agent"} />
    <meta property="og:description" content={description ?? "Quillby scans the internet for content relevant to your niche, delivers a curated brief, and writes drafts in your voice."} />
    <meta property="og:image" content={ogImage ?? "/og.png"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? "Quillby — Your AI Content Agent"} />
    <meta name="twitter:description" content={description ?? "Quillby scans the internet for content relevant to your niche, delivers a curated brief, and writes drafts in your voice."} />
    <meta name="twitter:image" content={ogImage ?? "/og.png"} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#5c3a7e" />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
