---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const entries = Object.entries(import.meta.glob('/src/content/legal/*/*.md', { eager: true }));
  return entries.map(([path, mod]) => {
    const segments = path.replace('/src/content/legal/', '').split('/');
    const lang = segments[0];
    const slug = segments[1].replace('.md', '');
    return {
      params: { lang, slug },
      props: { entry: mod as Record<string, unknown>, lang, slug },
    };
  });
}

const { entry, lang } = Astro.props as {
  entry: { frontmatter: { title: string; updated: string }; Content: unknown };
  lang: Lang;
};
const { Content } = entry;
---
<BaseLayout
  lang={lang}
  title={`${entry.frontmatter.title} — Quillby`}
  description={`${entry.frontmatter.title} — Quillby`}
>
  <Nav lang={lang} />
  <main class="legal-page">
    <article>
      <h1>{entry.frontmatter.title}</h1>
      <p class="legal-updated">{entry.frontmatter.updated}</p>
      <Content />
    </article>
  </main>
  <Footer lang={lang} />
</BaseLayout>

<style>
  .legal-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem clamp(1.5rem, 5vw, 5rem);
    min-height: calc(100vh - 200px);
  }

  .legal-page h1 {
    font-family: var(--serif);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .legal-updated {
    font-size: 0.875rem;
    color: var(--faint);
    margin-bottom: 2.5rem;
  }

  .legal-page h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }

  .legal-page h2:first-of-type {
    margin-top: 0;
  }

  .legal-page p {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-2);
    margin-bottom: 1rem;
  }

  .legal-page ul {
    list-style: disc;
    padding-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .legal-page ul li {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--text-2);
    margin-bottom: 0.375rem;
  }

  .legal-page a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal-page a:hover {
    color: var(--accent-h);
  }

  .legal-page code {
    font-family: var(--mono);
    font-size: 0.875em;
    background: var(--bg-subtle);
    padding: 0.15em 0.4em;
    border-radius: 4px;
  }

  .legal-page strong {
    color: var(--text);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .legal-page {
      padding: 2.5rem 1.25rem;
    }
    .legal-page h1 {
      font-size: 1.75rem;
    }
    .legal-page h2 {
      font-size: 1.25rem;
    }
  }
</style>
