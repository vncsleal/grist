---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import Hero from '../../components/Hero.astro';
import Problem from '../../components/Problem.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import CapabilitiesGrid from '../../components/CapabilitiesGrid.astro';
import CampaignsPlanning from '../../components/CampaignsPlanning.astro';
import Personas from '../../components/Personas.astro';
import Install from '../../components/Install.astro';
import TrustBanner from '../../components/TrustBanner.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import { useTranslations } from '../../i18n/utils';
import { type Lang } from '../../i18n/ui';
import { languages } from '../../i18n/ui';

export async function getStaticPaths() {
  return Object.keys(languages).map(lang => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t('meta.home.title')} description={t('meta.home.desc')}>
  <Nav lang={lang} />

  <Hero lang={lang} />

  <!-- STRIP -->
  <div class="strip" aria-hidden="true">
    <div class="strip-inner">
      <span>{t('strip.marketing')}</span>
      <span class="strip-sep">&middot;</span>
      <span>{t('strip.copywriting')}</span>
      <span class="strip-sep">&middot;</span>
      <span>{t('strip.content-creation')}</span>
      <span class="strip-sep">&middot;</span>
      <span>{t('strip.freelancers')}</span>
      <span class="strip-sep">&middot;</span>
      <span>{t('strip.business-owners')}</span>
      <span class="strip-sep">&middot;</span>
      <span>{t('strip.niche-specialists')}</span>
    </div>
  </div>

  <Problem lang={lang} />

  <HowItWorks lang={lang} />

  <CapabilitiesGrid lang={lang} />

  <CampaignsPlanning lang={lang} />

  <Personas lang={lang} />

  <Install lang={lang} />

  <TrustBanner lang={lang} />

  <Faq lang={lang} />

  <Cta lang={lang} />

  <Footer lang={lang} />
</BaseLayout>

<script>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
</script>

<style>
  .strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 0;
    overflow: hidden;
  }

  .strip-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .strip-sep { color: var(--border-strong); }

  @media (max-width: 640px) {
    .strip-inner { gap: 0.75rem 1rem; }
  }
</style>
