---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import CapabilitiesGrid from '../components/CapabilitiesGrid.astro';
import CampaignsPlanning from '../components/CampaignsPlanning.astro';
import Personas from '../components/Personas.astro';
import TrustBanner from '../components/TrustBanner.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
---

<BaseLayout
  title="Quillby — Your AI Content Agent"
  description="Quillby scans the internet for what matters in your niche, delivers a daily brief, and writes publish-ready drafts in your voice. Free. Runs locally."
>
  <Nav />

  <Hero />

  <!-- STRIP -->
  <div class="strip" aria-hidden="true">
    <div class="strip-inner">
      <span>Marketing</span>
      <span class="strip-sep">&middot;</span>
      <span>Copywriting</span>
      <span class="strip-sep">&middot;</span>
      <span>Content Creation</span>
      <span class="strip-sep">&middot;</span>
      <span>Freelancers</span>
      <span class="strip-sep">&middot;</span>
      <span>Business Owners</span>
      <span class="strip-sep">&middot;</span>
      <span>Niche Specialists</span>
    </div>
  </div>

  <!-- PROBLEM / BEFORE-AFTER -->
  <section class="section" aria-labelledby="problem-heading">
    <div class="container">
      <h2 class="section-h2 reveal" id="problem-heading">
        Consistent content is a<br /><em>full-time job you didn't sign up for.</em>
      </h2>
      <p class="section-p reveal reveal-delay-1">
        It's not that you lack ideas. It's that finding, filtering, and writing
        takes hours you don't have — every single day.
      </p>

      <div class="compare-grid reveal reveal-delay-2">
        <div class="compare-col compare-before">
          <div class="compare-label">Before Quillby</div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--minus" aria-hidden="true"></span>
            <div>
              <strong>45 minutes</strong> scanning feeds, newsletters, and Twitter to find one thing worth writing about.
            </div>
          </div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--minus" aria-hidden="true"></span>
            <div>
              <strong>Blank page paralysis.</strong> You know your subject. You don't know where to start.
            </div>
          </div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--minus" aria-hidden="true"></span>
            <div>
              <strong>Generic AI output.</strong> You try ChatGPT and it sounds like a LinkedIn HR bot.
            </div>
          </div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--minus" aria-hidden="true"></span>
            <div>
              <strong>Posting irregularly</strong> because "finding something to say" isn't part of your job.
            </div>
          </div>
        </div>

        <div class="compare-divider" aria-hidden="true"></div>

        <div class="compare-col compare-after">
          <div class="compare-label">With Quillby</div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--plus" aria-hidden="true"></span>
            <div>
              Ask Claude <strong>"what should I post today?"</strong> and get a ranked brief of what's relevant.
            </div>
          </div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--plus" aria-hidden="true"></span>
            <div>
              <strong>One-shot drafts</strong> sourced from real articles, structured as your kind of post.
            </div>
          </div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--plus" aria-hidden="true"></span>
            <div>
              <strong>Sounds like you</strong> — not a template. Quillby learns your voice from examples you approve.
            </div>
          </div>
          <div class="compare-item">
            <span class="compare-marker compare-marker--plus" aria-hidden="true"></span>
            <div>
              <strong>Publish consistently</strong> without adding a single new tool, tab, or workflow to your day.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <HowItWorks />

  <CapabilitiesGrid />

  <CampaignsPlanning />

  <Personas />

  <Install />

  <TrustBanner />

  <Faq />

  <!-- FINAL CTA -->
  <section class="cta-final" aria-labelledby="cta-heading">
    <div class="container cta-final-inner">
      <h2 class="cta-h2 reveal" id="cta-heading">
        Stop reading feeds.<br /><em>Start shipping content.</em>
      </h2>
      <p class="cta-sub reveal reveal-delay-1">
        Install in three minutes. Your first brief, right after.
      </p>
      <div class="reveal reveal-delay-2">
        <a
          href="https://github.com/vncsleal/quillby/releases/latest/download/quillby-macos.pkg"
          class="btn btn-primary btn-large"
        >
          Install Quillby free
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));
</script>

<style>
  /* Strip */
  .strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 0;
    overflow: hidden;
  }

  .strip-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .strip-sep { color: var(--border-strong); }

  /* Compare grid */
  .compare-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 2rem;
    align-items: start;
    padding-top: 0.5rem;
  }

  .compare-label {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .compare-col {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .compare-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text);
  }

  .compare-item strong { font-weight: 500; }

  .compare-before .compare-item { color: var(--muted); }

  .compare-marker {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 600;
    margin-top: 0.2rem;
  }

  .compare-marker--minus {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    color: var(--faint);
  }

  .compare-marker--minus::after { content: '—'; }

  .compare-marker--plus {
    background: var(--accent);
    color: #fff;
  }

  .compare-marker--plus::after { content: '+'; }

  .compare-divider {
    width: 1px;
    background: var(--border);
    align-self: stretch;
  }

  /* Final CTA */
  .cta-final {
    padding: var(--sp-section) 0;
    background: var(--text);
    color: var(--inverse);
  }

  .cta-final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }

  .cta-h2 {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 500;
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 100;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--inverse);
    margin-bottom: 1.25rem;
  }

  .cta-h2 em { font-style: italic; }

  .cta-sub {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(250, 248, 245, 0.6);
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .cta-final .btn-primary { background: var(--accent); color: #fff; }
  .cta-final .btn-primary:hover { opacity: 0.85; background: var(--accent-h); }

  @media (max-width: 860px) {
    .compare-grid { gap: 1.5rem; }
  }

  @media (max-width: 720px) {
    .compare-grid { grid-template-columns: 1fr; }
    .compare-divider { display: none; }
    .compare-before { padding-bottom: 1.5rem; border-bottom: 1px solid var(--border); }
  }

  @media (max-width: 640px) {
    .strip-inner { gap: 0.75rem 1rem; }
  }

  @media (max-width: 480px) {
    .stats-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
