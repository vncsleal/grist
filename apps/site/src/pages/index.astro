---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Quillby — Your AI Content Agent"
  description="Quillby scans the internet for what matters in your niche, delivers a daily brief, and writes publish-ready drafts in your voice. Free. Runs locally."
>
  <Nav />

  <!-- ═══ HERO ═══ -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-inner">
      <div class="hero-text">
        <h1 class="hero-h1 reveal reveal-delay-1" id="hero-heading">
          You read the brief.<br />
          <em>It writes the post.</em>
        </h1>
        <p class="hero-sub reveal reveal-delay-2">
          Quillby scans the internet for what matters in your niche,
          delivers a daily brief, and writes publish-ready drafts in your voice.
        </p>
        <div class="hero-actions reveal reveal-delay-3">
          <a href="#install" class="btn btn-primary">Install free</a>
          <a href="#how-it-works" class="btn btn-ghost">See how it works</a>
        </div>
        <p class="hero-note reveal reveal-delay-4">Free &middot; Local &middot; Works with Claude Desktop</p>
      </div>

      <div class="hero-visual reveal reveal-delay-2">
        <div class="mascot-wrap">
          <img
            src="/hero-mascot-alpha.webp"
            alt=""
            class="mascot-img"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SOCIAL PROOF STRIP ═══ -->
  <div class="strip" aria-hidden="true">
    <div class="strip-inner">
      <span>Marketing</span>
      <span class="strip-sep">&middot;</span>
      <span>Copywriting</span>
      <span class="strip-sep">&middot;</span>
      <span>Content Creation</span>
      <span class="strip-sep">&middot;</span>
      <span>Freelancers</span>
      <span class="strip-sep">&middot;</span>
      <span>Business Owners</span>
      <span class="strip-sep">&middot;</span>
      <span>Niche Specialists</span>
    </div>
  </div>

  <!-- ═══ PROBLEM ═══ -->
  <section class="section" aria-labelledby="problem-heading">
    <div class="container">
      <h2 class="section-h2 reveal" id="problem-heading">
        Consistent content is a<br /><em>full-time job you didn't sign up for.</em>
      </h2>
      <p class="section-p reveal reveal-delay-1">
        It's not that you lack ideas. It's that finding, filtering, and writing
        takes hours you don't have — every single day.
      </p>
      <div class="stats-grid reveal reveal-delay-2">
        <div class="stat">
          <span class="stat-num">40<small>min</small></span>
          <span class="stat-desc">reading feeds daily</span>
        </div>
        <div class="stat">
          <span class="stat-num">6<small>hrs</small></span>
          <span class="stat-desc">writing per week</span>
        </div>
        <div class="stat">
          <span class="stat-num">70<small>%</small></span>
          <span class="stat-desc">quit within 3 months</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ HOW IT WORKS ═══ -->
  <section class="section" id="how-it-works" aria-labelledby="how-heading">
    <div class="container">
      <p class="label reveal">How it works</p>
      <h2 class="section-h2 reveal reveal-delay-1" id="how-heading">Three conversations. Done.</h2>

      <div class="steps">
        <!-- Step 1 -->
        <div class="step reveal">
          <div class="step-header">
            <span class="step-num">01</span>
            <div class="step-line"></div>
          </div>
          <div class="step-body">
            <h3 class="step-h3">Install &amp; configure</h3>
            <p class="step-p">
              Double-click the installer, restart Claude. It asks about your niche
              and tone. You answer once.
            </p>
            <div class="chat">
              <div class="chat-row chat-user">
                <span class="chat-who">You</span>
                <p class="chat-bubble">Set me up as a TypeScript content creator.</p>
              </div>
              <div class="chat-row chat-ai">
                <span class="chat-who">Quillby</span>
                <p class="chat-bubble">Got it. I'll focus on TypeScript, web performance, and DX. What platforms do you post on?</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="step reveal reveal-delay-1">
          <div class="step-header">
            <span class="step-num">02</span>
            <div class="step-line"></div>
          </div>
          <div class="step-body">
            <h3 class="step-h3">Get your daily brief</h3>
            <p class="step-p">
              Every morning, a curated summary of what's relevant to your niche.
              Scan it in two minutes.
            </p>
            <div class="chat">
              <div class="chat-row chat-user">
                <span class="chat-who">You</span>
                <p class="chat-bubble">Give me today's brief.</p>
              </div>
              <div class="chat-row chat-ai">
                <span class="chat-who">Quillby</span>
                <p class="chat-bubble">Here's what happened in TypeScript today: Bun 1.2 ships native TS enums, TC39 Stage 4 for Set methods, Vercel drops Edge runtime in favor of…</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="step reveal reveal-delay-2">
          <div class="step-header">
            <span class="step-num">03</span>
            <div class="step-line"></div>
          </div>
          <div class="step-body">
            <h3 class="step-h3">Draft in your voice</h3>
            <p class="step-p">
              Pick a story, ask for the post. Quillby writes a publish-ready draft
              based on the real article, in your established voice.
            </p>
            <div class="chat">
              <div class="chat-row chat-user">
                <span class="chat-who">You</span>
                <p class="chat-bubble">Write a LinkedIn post about the Bun update.</p>
              </div>
              <div class="chat-row chat-ai">
                <span class="chat-who">Quillby</span>
                <p class="chat-bubble">Draft ready — 220 words, punchy opening, ends with a question to drive comments. Want me to shorten it?</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ WHO IT'S FOR ═══ -->
  <section class="section" id="who-its-for" aria-labelledby="who-heading">
    <div class="container">
      <p class="label reveal">Who it's for</p>
      <h2 class="section-h2 reveal reveal-delay-1" id="who-heading">
        Built for people who create content<br /><em>alongside everything else.</em>
      </h2>

      <div class="personas">
        <div class="persona reveal">
          <h3 class="persona-name">Freelance Copywriter</h3>
          <p class="persona-desc">
            Multiple clients, each with their own voice. One workspace per client.
            Separate briefs, drafts in the right tone.
          </p>
        </div>
        <div class="persona reveal reveal-delay-1">
          <h3 class="persona-name">Business Owner</h3>
          <p class="persona-desc">
            You know your market cold, but posting consistently? There's never time.
            Quillby keeps your brand visible without the grind.
          </p>
        </div>
        <div class="persona reveal">
          <h3 class="persona-name">Marketing Professional</h3>
          <p class="persona-desc">
            Track competitors, surface trends, spot case studies.
            Turn all of it into content your audience actually reads.
          </p>
        </div>
        <div class="persona reveal reveal-delay-1">
          <h3 class="persona-name">Niche Specialist</h3>
          <p class="persona-desc">
            Law, finance, health, education, tech. Any field where
            consistent content builds authority — and silence erodes it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ PRIVACY CALLOUT ═══ -->
  <section class="privacy-banner reveal">
    <div class="container">
      <div class="privacy-inner">
        <div class="privacy-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10 1.667L3.333 4.167v5c0 3.917 2.834 7.583 6.667 8.5 3.833-.917 6.667-4.583 6.667-8.5v-5L10 1.667z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
            <path d="M7.5 10l1.667 1.667 3.333-3.334" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <div class="privacy-text">
          <strong>Your data stays on your machine.</strong>
          Everything runs locally. Nothing is sent to our servers.
          Quillby is open source and fully auditable.
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ INSTALL ═══ -->
  <section class="section" id="install" aria-labelledby="install-heading">
    <div class="container">
      <p class="label reveal">Get started</p>
      <h2 class="section-h2 reveal reveal-delay-1" id="install-heading">
        Three minutes to your<br /><em>first draft.</em>
      </h2>

      <ol class="install-steps reveal reveal-delay-2">
        <li>
          <span class="install-num">1</span>
          <div>
            <strong>Download the installer</strong>
            <span class="install-detail">Double-click and follow the prompts. No terminal needed.</span>
          </div>
        </li>
        <li>
          <span class="install-num">2</span>
          <div>
            <strong>Restart Claude Desktop</strong>
            <span class="install-detail">Quillby appears automatically the next time you open Claude.</span>
          </div>
        </li>
        <li>
          <span class="install-num">3</span>
          <div>
            <strong>Configure your niche</strong>
            <span class="install-detail">Claude asks two questions. You answer once. That's the setup.</span>
          </div>
        </li>
      </ol>

      <div class="install-cta reveal reveal-delay-3">
        <a
          href="https://github.com/vncsleal/quillby/releases/latest/download/quillby-macos.pkg"
          class="btn btn-primary btn-large"
        >
          Download for Mac
        </a>
        <p class="install-note">macOS &middot; Free &middot; No account required</p>
      </div>

      <details class="other-installs reveal">
        <summary>Other platforms</summary>
        <div class="other-installs-body">
          <p>
            <span class="platform-label">Windows</span>
            <a href="https://github.com/vncsleal/quillby/releases/latest/download/quillby-windows.exe">Download .exe</a>
          </p>
          <p>
            <span class="platform-label">Linux / npm</span>
            <code>npm install -g @vncsleal/quillby</code>
          </p>
          <p>
            <a href="/docs/install">Full installation guide &rarr;</a>
          </p>
        </div>
      </details>
    </div>
  </section>

  <!-- ═══ FAQ ═══ -->
  <section class="section section-sm" id="faq" aria-labelledby="faq-heading">
    <div class="container">
      <p class="label reveal">FAQ</p>
      <h2 class="section-h2 reveal reveal-delay-1" id="faq-heading">Common questions</h2>

      <div class="faq-list">
        <details class="faq-item reveal">
          <summary>Do I need to know how to code?</summary>
          <div class="faq-body"><p>No. If you can have a conversation with Claude, you can use Quillby.</p></div>
        </details>
        <details class="faq-item reveal reveal-delay-1">
          <summary>Does it work for any niche?</summary>
          <div class="faq-body"><p>Yes. Tech, law, finance, health, education, marketing — any field with content online.</p></div>
        </details>
        <details class="faq-item reveal reveal-delay-2">
          <summary>I have multiple clients. Will they mix?</summary>
          <div class="faq-body"><p>No. Each workspace has its own memory and sources. Client A never bleeds into Client B.</p></div>
        </details>
        <details class="faq-item reveal reveal-delay-3">
          <summary>Is my data safe?</summary>
          <div class="faq-body"><p>Everything runs on your machine. Nothing leaves it. The code is open source and auditable.</p></div>
        </details>
        <details class="faq-item reveal reveal-delay-4">
          <summary>Is it free?</summary>
          <div class="faq-body"><p>Local mode is completely free. A Cloud tier (shared workspaces, team dashboard) is in development.</p></div>
        </details>
        <details class="faq-item reveal reveal-delay-4">
          <summary>Do I need Claude Desktop?</summary>
          <div class="faq-body"><p>Yes. Quillby is an MCP server for Claude Desktop. It extends Claude with content agent capabilities.</p></div>
        </details>
      </div>
    </div>
  </section>

  <!-- ═══ FINAL CTA ═══ -->
  <section class="cta-final" aria-labelledby="cta-heading">
    <div class="container cta-final-inner">
      <h2 class="cta-h2 reveal" id="cta-heading">
        Stop reading feeds.<br /><em>Start shipping content.</em>
      </h2>
      <p class="cta-sub reveal reveal-delay-1">
        Install in three minutes. Your first brief, right after.
      </p>
      <div class="reveal reveal-delay-2">
        <a
          href="https://github.com/vncsleal/quillby/releases/latest/download/quillby-macos.pkg"
          class="btn btn-primary btn-large"
        >
          Install Quillby free
        </a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>

<script>
  // Reveal on scroll
  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1, rootMargin: '0px 0px -40px 0px' }
  );
  document.querySelectorAll('.reveal').forEach(el => revealObserver.observe(el));

  // FAQ animated open/close
  document.querySelectorAll('.faq-item').forEach(el => {
    const details = el as HTMLDetailsElement;
    const summary = details.querySelector('summary');
    if (!summary) return;

    summary.addEventListener('click', (e) => {
      e.preventDefault();

      if (details.open) {
        // Close: add closing class, wait for transition, then remove [open]
        details.classList.add('is-closing');
        const body = details.querySelector('.faq-body') as HTMLElement;
        body.addEventListener('transitionend', () => {
          details.open = false;
          details.classList.remove('is-closing');
        }, { once: true });
      } else {
        // Open: set [open] first so content is visible, then transition in
        details.open = true;
      }
    });
  });
</script>

<style>
  /* ─── Shared tokens ─── */
  .container { max-width: 1440px; margin: 0 auto; padding: 0 clamp(0.75rem, 2vw, 1.5rem); }
  .container.narrow { max-width: 960px; }

  .section { padding: var(--sp-section) 0; }
  .section-sm { padding: var(--sp-section-sm) 0; }

  /* ─── Typography ─── */
  .label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .section-h2 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 500;
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 100;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .section-h2 em {
    font-style: italic;
    font-weight: 500;
  }

  .section-p {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 60ch;
    margin-bottom: 2.5rem;
  }

  /* ─── Buttons ─── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.5rem;
    font-family: var(--serif);
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 8px;
    text-decoration: none;
    transition: background-color 0.3s var(--ease-out), color 0.3s var(--ease-out), border-color 0.3s var(--ease-out), transform 0.2s var(--ease-out);
    white-space: nowrap;
    will-change: transform;
  }

  .btn:active { transform: scale(0.97); }

  .btn-primary {
    background: var(--accent);
    color: #fff;
  }
  .btn-primary:hover { background: var(--accent-h); }

  .btn-ghost {
    background: transparent;
    color: var(--muted);
    border: 1px solid var(--border);
  }
  .btn-ghost:hover { border-color: var(--text); color: var(--text); }

  .btn-large {
    padding: 0.85rem 2rem;
    font-size: 0.9375rem;
    border-radius: 10px;
  }

  /* ─── HERO ─── */
  .hero {
    min-height: calc(100svh - 56px);
    display: flex;
    align-items: center;
    padding: 3rem 0 4rem;
  }

  .hero-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 5rem;
    align-items: center;
    width: 100%;
  }

  .hero-eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero-h1 {
    font-family: var(--serif);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 500;
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 100;
    line-height: 1.02;
    letter-spacing: -0.025em;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .hero-h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--text-2);
  }

  .hero-sub {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--muted);
    max-width: 56ch;
    margin-bottom: 2.25rem;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .hero-note {
    font-size: 0.75rem;
    color: var(--faint);
    letter-spacing: 0.02em;
  }

  /* Hero visual */
  .hero-visual {
    display: flex;
    justify-content: center;
  }

  .mascot-wrap {
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  .mascot-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ─── STRIP ─── */
  .strip {
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    padding: 0.875rem 0;
    overflow: hidden;
  }

  .strip-inner {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 clamp(0.75rem, 2vw, 1.5rem);
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .strip-sep { color: var(--border-strong); }

  /* ─── STATS ─── */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 280px));
    gap: 3rem;
    padding-top: 0.5rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat-num {
    font-family: var(--serif);
    font-size: 2.75rem;
    font-weight: 300;
    line-height: 1;
    color: var(--text);
    letter-spacing: -0.03em;
  }

  .stat-num small {
    font-size: 1.25rem;
    font-weight: 300;
    letter-spacing: 0;
  }

  .stat-desc {
    font-size: 0.8125rem;
    color: var(--muted);
    line-height: 1.4;
  }

  /* ─── STEPS ─── */
  .steps {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 3rem;
  }

  .step {
    display: flex;
    flex-direction: column;
  }

  .step-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .step-num {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--faint);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .step-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .step-h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    font-optical-sizing: auto;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .step-p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  /* Chat */
  .chat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chat-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .chat-who {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    padding: 0 0.75rem;
  }

  .chat-bubble {
    font-size: 0.875rem;
    line-height: 1.55;
    padding: 0.625rem 0.875rem;
    border-radius: 10px;
    max-width: 90%;
  }

  .chat-user .chat-bubble {
    background: var(--bg-subtle);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 3px;
    align-self: flex-start;
  }

  .chat-ai .chat-bubble {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 3px;
    align-self: flex-start;
  }

  /* ─── PERSONAS ─── */
  .personas {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .persona {
    padding: 2rem 2rem 2rem 0;
    border-top: 1px solid var(--border);
  }

  .personas .persona:not(:last-child) {
    border-right: 1px solid var(--border);
  }

  .personas .persona:not(:first-child) {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .personas .persona:last-child {
    padding-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .personas .persona:first-child {
    border-bottom: 1px solid var(--border);
  }

  .personas .persona:nth-child(2),
  .personas .persona:nth-child(3) {
    border-bottom: 1px solid var(--border);
  }

  .persona-name {
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 500;
    font-optical-sizing: auto;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .persona-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
  }

