---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout title="Blog — Quillby">
  <Nav />
  <main class="blog-page">
    <h1 class="blog-title">Blog</h1>
    <p class="blog-intro">Em breve — tutoriais, guias, cases e novidades do Quillby.</p>
    <a href="/docs" class="blog-link">Enquanto isso, confira a documentação →</a>
  </main>
  <Footer />
</BaseLayout>

<style>
  .blog-page {
    position: relative; z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 4rem clamp(1.5rem, 5vw, 5rem);
    min-height: calc(100vh - 200px);
    text-align: center;
  }
  .blog-title {
    font-family: var(--serif);
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
    margin-bottom: 1rem;
  }
  .blog-intro {
    font-size: 1.0625rem;
    color: var(--muted);
    margin-bottom: 2rem;
  }
  .blog-link {
    color: var(--accent);
    font-size: 1rem;
    text-decoration: none;
    font-weight: 600;
  }
  .blog-link:hover { text-decoration: underline; }
</style>
