---
import { getCollection } from "astro:content";
import ContentLayout from "../../layouts/ContentLayout.astro";

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs.map(entry => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const currentPath = Astro.url.pathname;
const isPT = currentPath.startsWith('/docs/pt/');
const enSidebar = [
  { href: "/docs/install", label: "Install" },
  { href: "/docs/getting-started", label: "Getting Started" },
  { href: "/docs/features", label: "Features" },
  { href: "/docs/faq", label: "FAQ" },
];
const ptSidebar = [
  { href: "/docs/pt/instalar", label: "Instalar" },
  { href: "/docs/pt/primeiros-passos", label: "Primeiros Passos" },
  { href: "/docs/pt/faq", label: "FAQ" },
];
const sidebar = isPT ? ptSidebar : enSidebar;
---
<ContentLayout title={entry.data.title} description={entry.data.description} entry={entry} sidebar={sidebar} />
