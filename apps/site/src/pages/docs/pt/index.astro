---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
import { getCollection } from 'astro:content';
const allDocs = await getCollection('docs');
const ptDocs = allDocs.filter(d => d.id.startsWith('pt/')).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
---
<BaseLayout title="Documentação — Quillby">
  <Nav lang="pt" />
  <div class="layout">
    <aside class="sidebar">
      <nav>
        <a href="/docs/pt" class="sidebar-header">Documentação</a>
        <ul class="sidebar-list">
          {ptDocs.map(doc => (
            <li><a href={`/docs/${doc.id}`} class="sidebar-item">{doc.data.title}</a></li>
          ))}
        </ul>
      </nav>
    </aside>
    <main class="content">
      <h1 class="h1">Documentação</h1>
      <p class="intro">Guias e referência para instalar e usar o Quillby.</p>
      <div class="cards">
        {ptDocs.map(doc => (
          <a href={`/docs/${doc.id}`} class="card">
            <h3 class="card-title">{doc.data.title}</h3>
            <p class="card-desc">{doc.data.description}</p>
          </a>
        ))}
      </div>
    </main>
  </div>
  <Footer />
</BaseLayout>

<style>
  .layout { display: flex; max-width: 1440px; margin: 0 auto; padding: 3rem 0; min-height: calc(100vh - 200px); gap: 3rem; }
  .sidebar { flex: 0 0 200px; position: sticky; top: 80px; align-self: flex-start; }
  .sidebar-header { display: block; font-family: var(--serif); font-size: 1rem; font-weight: 500; color: var(--text); text-decoration: none; margin-bottom: 1.25rem; }
  .sidebar-header:hover { color: var(--accent); }
  .sidebar-list { list-style: none; display: flex; flex-direction: column; gap: 0.125rem; }
  .sidebar-item { font-size: 0.8125rem; color: var(--muted); text-decoration: none; padding: 0.4rem 0.75rem; border-radius: 6px; transition: background 0.15s, color 0.15s; display: block; }
  .sidebar-item:hover { background: var(--bg-subtle); color: var(--text); }
  .content { flex: 1; min-width: 0; padding-right: clamp(0.75rem, 2vw, 1.5rem); }
  .h1 { font-family: var(--serif); font-size: clamp(2rem, 4vw, 3rem); font-weight: 500; font-optical-sizing: auto; font-variation-settings: "SOFT" 100; line-height: 1.1; letter-spacing: -0.02em; color: var(--text); margin-bottom: 1rem; }
  .intro { font-size: 1.0625rem; line-height: 1.7; color: var(--muted); margin-bottom: 2.5rem; max-width: 48ch; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
  .card { display: block; padding: 1.5rem; border: 1px solid var(--border); border-radius: 10px; text-decoration: none; transition: border-color 0.3s var(--ease-out); }
  .card:hover { border-color: var(--accent); }
  .card-title { font-family: var(--serif); font-size: 1rem; font-weight: 500; color: var(--text); margin-bottom: 0.35rem; }
  .card-desc { font-size: 0.875rem; color: var(--muted); line-height: 1.6; }
  @media (max-width: 768px) { .layout { flex-direction: column; gap: 1.5rem; padding-left: clamp(0.75rem, 2vw, 1.5rem); padding-right: clamp(0.75rem, 2vw, 1.5rem); } .sidebar { flex: none; position: static; padding: 0; } .sidebar-list { flex-direction: row; flex-wrap: wrap; } .content { padding-right: 0; } }
</style>
