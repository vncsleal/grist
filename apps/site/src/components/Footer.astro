---
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-logo">
        <img src="/favicon.png" alt="" width="24" height="24" />
        <span>Quillby</span>
      </a>
      <p class="footer-tagline">Your AI content agent for Claude.</p>
    </div>
    <nav class="footer-links" aria-label="Footer navigation">
      <div class="footer-col">
        <span class="footer-col-label">Product</span>
        <a href="/#how-it-works">How it works</a>
        <a href="/#who-its-for">Who it's for</a>
        <a href="/#install">Install</a>
        <a href="/#faq">FAQ</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-label">Resources</span>
        <a href="/docs">Docs</a>
        <a href="https://github.com/vncsleal/quillby" target="_blank" rel="noopener noreferrer">GitHub</a>
      </div>
      <div class="footer-col">
        <span class="footer-col-label">Legal</span>
        <a href="/privacy">Privacy</a>
        <a href="/terms">Terms</a>
      </div>
    </nav>
  </div>
  <div class="footer-bottom">
    <p>&copy; {year} Quillby &middot; Free &middot; Open source &middot; Local-first</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 3.5rem clamp(0.75rem, 2vw, 1.5rem) 2rem;
  }

  .footer-inner {
    max-width: 1440px;
    margin: 0 auto;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 3rem;
    flex-wrap: wrap;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--border);
  }

  /* Brand */
  .footer-brand {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-width: 220px;
  }

  .footer-logo {
    display: flex;
    align-items: center;
    gap: 7px;
    text-decoration: none;
    color: var(--text);
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .footer-logo img { border-radius: 5px; }

  .footer-tagline {
    font-size: 0.8125rem;
    color: var(--faint);
    line-height: 1.5;
  }

  /* Link columns */
  .footer-links {
    display: flex;
    gap: 3.5rem;
    flex-wrap: wrap;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-col-label {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 0.25rem;
  }

  .footer-col a {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.15s;
    line-height: 1.4;
  }

  .footer-col a:hover { color: var(--text); }

  /* Bottom bar */
  .footer-bottom {
    max-width: 1440px;
    margin: 0 auto;
    padding-top: 1.5rem;
  }

  .footer-bottom p {
    font-size: 0.75rem;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .footer-inner {
      flex-direction: column;
      gap: 2rem;
      padding-bottom: 2rem;
    }
    .footer-links { gap: 2rem; }
    .footer-brand { max-width: none; }
  }
</style>
