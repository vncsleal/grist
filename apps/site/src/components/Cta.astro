---
import { useTranslations } from '../i18n/utils';
import { type Lang, defaultLang } from '../i18n/ui';
const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---
<section class="cta-final" aria-labelledby="cta-heading">
  <div class="container cta-final-inner">
    <h2 class="cta-h2 reveal" id="cta-heading">
      {t('cta.heading')}<br /><em>{t('cta.heading-em')}</em>
    </h2>
    <p class="cta-sub reveal reveal-delay-1">{t('cta.sub')}</p>
    <div class="reveal reveal-delay-2">
      <a
        href="https://github.com/vncsleal/quillby/releases/latest/download/quillby-macos.dmg"
        class="btn btn-primary btn-large"
      >
        {t('cta.cta')}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-final {
    padding: var(--sp-section) 0;
    background: var(--text);
    color: var(--inverse);
  }

  .cta-final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
  }

  .cta-h2 {
    font-family: var(--serif);
    font-size: clamp(2.2rem, 5vw, 4rem);
    font-weight: 500;
    font-optical-sizing: auto;
    font-variation-settings: "SOFT" 100;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--inverse);
    margin-bottom: 1.25rem;
  }

  .cta-h2 em { font-style: italic; }

  .cta-sub {
    font-size: 1rem;
    line-height: 1.65;
    color: rgba(250, 248, 245, 0.6);
    max-width: 52ch;
    margin-bottom: 2.5rem;
  }

  .cta-final .btn-primary { background: var(--accent); color: #fff; }
  .cta-final .btn-primary:hover { opacity: 0.85; background: var(--accent-h); }
</style>
