---
import { useTranslations } from '../i18n/utils';
import { type Lang, defaultLang } from '../i18n/ui';
const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---
<section class="section" id="who-its-for" aria-labelledby="who-heading">
  <div class="container">
    <p class="label reveal">{t('personas.label')}</p>
    <h2 class="section-h2 reveal reveal-delay-1" id="who-heading">
      {t('personas.heading')}<br /><em>{t('personas.heading-em')}</em>
    </h2>

    <div class="personas">
      <div class="persona reveal">
        <h3 class="persona-name">{t('personas.copywriter-name')}</h3>
        <p class="persona-desc">{t('personas.copywriter-desc')}</p>
      </div>
      <div class="persona reveal reveal-delay-1">
        <h3 class="persona-name">{t('personas.entrepreneur-name')}</h3>
        <p class="persona-desc">{t('personas.entrepreneur-desc')}</p>
      </div>
      <div class="persona reveal">
        <h3 class="persona-name">{t('personas.marketer-name')}</h3>
        <p class="persona-desc">{t('personas.marketer-desc')}</p>
      </div>
      <div class="persona reveal reveal-delay-1">
        <h3 class="persona-name">{t('personas.niche-name')}</h3>
        <p class="persona-desc">{t('personas.niche-desc')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .personas {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
  }

  .persona {
    padding: 2rem 2rem 2rem 0;
    border-top: 1px solid var(--border);
  }

  .personas .persona:not(:last-child) {
    border-right: 1px solid var(--border);
  }

  .personas .persona:not(:first-child) {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .personas .persona:last-child {
    padding-right: 0;
    border-bottom: 1px solid var(--border);
  }

  .personas .persona:first-child {
    border-bottom: 1px solid var(--border);
  }

  .personas .persona:nth-child(2),
  .personas .persona:nth-child(3) {
    border-bottom: 1px solid var(--border);
  }

  .persona-name {
    font-family: var(--serif);
    font-size: 1.0625rem;
    font-weight: 500;
    font-optical-sizing: auto;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .persona-desc {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .personas {
      grid-template-columns: repeat(2, 1fr);
    }
    .personas .persona:nth-child(odd) {
      border-right: 1px solid var(--border);
    }
    .personas .persona:nth-child(even) {
      border-right: none;
    }
    .personas .persona:nth-last-child(-n+2) {
      border-bottom: 1px solid var(--border);
    }
  }

  @media (max-width: 640px) {
    .personas {
      grid-template-columns: 1fr;
    }
    .personas .persona {
      padding: 1.5rem 0 !important;
      border-right: none !important;
    }
    .personas .persona:last-child {
      border-bottom: 1px solid var(--border);
    }
  }
</style>
