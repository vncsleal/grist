---
import { useTranslations } from '../i18n/utils';
import { type Lang, defaultLang } from '../i18n/ui';
const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---
<section class="section" id="capabilities" aria-labelledby="caps-heading">
  <div class="container">
    <p class="label reveal">{t('caps.label')}</p>
    <h2 class="section-h2 reveal reveal-delay-1" id="caps-heading">
      {t('caps.heading')}<br /><em>{t('caps.heading-em')}</em>
    </h2>

    <div class="caps-grid reveal reveal-delay-2">
      <div class="caps-card">
        <div class="caps-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <circle cx="9" cy="9" r="7.5" stroke="currentColor" stroke-width="1.3"/>
            <path d="M4.5 9h9M9 4.5v9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          </svg>
        </div>
        <h3 class="caps-name">{t('caps.monitor-title')}</h3>
        <p class="caps-desc">{t('caps.monitor-desc')}</p>
      </div>

      <div class="caps-card">
        <div class="caps-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M3 14l2-2 2 2 2-2 2 2 2-2 2 2V4H3v10z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            <path d="M5 8.5l2 2 3-3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="caps-name">{t('caps.draft-title')}</h3>
        <p class="caps-desc">{t('caps.draft-desc')}</p>
      </div>

      <div class="caps-card">
        <div class="caps-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M2 9c0-3.314 1.343-6 3-6s3 2.686 3 6-1.343 6-3 6-3-2.686-3-6z" stroke="currentColor" stroke-width="1.3"/>
            <path d="M10 9c0-3.314 1.343-6 3-6s3 2.686 3 6-1.343 6-3 6-3-2.686-3-6z" stroke="currentColor" stroke-width="1.3"/>
          </svg>
        </div>
        <h3 class="caps-name">{t('caps.voice-title')}</h3>
        <p class="caps-desc">{t('caps.voice-desc')}</p>
      </div>

      <div class="caps-card">
        <div class="caps-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <rect x="2" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/>
            <rect x="10" y="2" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/>
            <rect x="2" y="10" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/>
            <rect x="10" y="10" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.3"/>
          </svg>
        </div>
        <h3 class="caps-name">{t('caps.workspace-title')}</h3>
        <p class="caps-desc">{t('caps.workspace-desc')}</p>
      </div>

      <div class="caps-card">
        <div class="caps-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M9 1v16M1 9h16" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.3"/>
          </svg>
        </div>
        <h3 class="caps-name">{t('caps.plan-title')}</h3>
        <p class="caps-desc">{t('caps.plan-desc')}</p>
      </div>

      <div class="caps-card">
        <div class="caps-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M2 14.5c0-2.761 1.567-5 3.5-5s3.5 2.239 3.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="5.5" cy="5.5" r="2" stroke="currentColor" stroke-width="1.3"/>
            <path d="M10.5 16c0-2.761 1.567-5 3.5-5s3.5 2.239 3.5 5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
            <circle cx="14" cy="5.5" r="2" stroke="currentColor" stroke-width="1.3"/>
          </svg>
        </div>
        <h3 class="caps-name">{t('caps.team-title')}</h3>
        <p class="caps-desc">{t('caps.team-desc')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .caps-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .caps-card {
    padding: 1.75rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    transition: border-color 0.3s var(--ease-out);
  }

  .caps-card:hover { border-color: var(--accent); }

  .caps-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    color: var(--accent);
    margin-bottom: 1rem;
  }

  .caps-name {
    font-family: var(--serif);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .caps-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .caps-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .caps-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
