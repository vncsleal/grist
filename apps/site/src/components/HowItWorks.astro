---
import { useTranslations } from '../i18n/utils';
import { type Lang, defaultLang } from '../i18n/ui';
const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---
<section class="section" id="how-it-works" aria-labelledby="how-heading">
  <div class="container">
    <p class="label reveal">{t('how.label')}</p>
    <h2 class="section-h2 reveal reveal-delay-1" id="how-heading">{t('how.heading')}</h2>

    <div class="steps">
      <div class="step reveal">
        <div class="step-header">
          <span class="step-num">01</span>
          <div class="step-line"></div>
        </div>
        <div class="step-body">
          <h3 class="step-h3">{t('how.step-1-title')}</h3>
          <p class="step-p">{t('how.step-1-desc')}</p>
          <div class="chat">
            <div class="chat-row chat-user">
              <span class="chat-who">{t('how.step-1-user')}</span>
              <p class="chat-bubble">{t('how.step-1-user-text')}</p>
            </div>
            <div class="chat-row chat-ai">
              <span class="chat-who">Quillby</span>
              <p class="chat-bubble">{t('how.step-1-ai-text')}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="step reveal reveal-delay-1">
        <div class="step-header">
          <span class="step-num">02</span>
          <div class="step-line"></div>
        </div>
        <div class="step-body">
          <h3 class="step-h3">{t('how.step-2-title')}</h3>
          <p class="step-p">{t('how.step-2-desc')}</p>
          <div class="chat">
            <div class="chat-row chat-user">
              <span class="chat-who">{t('how.step-2-user')}</span>
              <p class="chat-bubble">{t('how.step-2-user-text')}</p>
            </div>
            <div class="chat-row chat-ai">
              <span class="chat-who">Quillby</span>
              <p class="chat-bubble">{t('how.step-2-ai-text')}</p>
            </div>
          </div>
        </div>
      </div>

      <div class="step reveal reveal-delay-2">
        <div class="step-header">
          <span class="step-num">03</span>
          <div class="step-line"></div>
        </div>
        <div class="step-body">
          <h3 class="step-h3">{t('how.step-3-title')}</h3>
          <p class="step-p">{t('how.step-3-desc')}</p>
          <div class="chat">
            <div class="chat-row chat-user">
              <span class="chat-who">{t('how.step-3-user')}</span>
              <p class="chat-bubble">{t('how.step-3-user-text')}</p>
            </div>
            <div class="chat-row chat-ai">
              <span class="chat-who">Quillby</span>
              <p class="chat-bubble">{t('how.step-3-ai-text')}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .steps {
    margin-top: 3.5rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0 3rem;
  }

  .step {
    display: flex;
    flex-direction: column;
  }

  .step-header {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .step-num {
    font-family: var(--mono);
    font-size: 0.6875rem;
    font-weight: 500;
    color: var(--faint);
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }

  .step-line {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .step-h3 {
    font-family: var(--serif);
    font-size: 1.25rem;
    font-weight: 500;
    font-optical-sizing: auto;
    color: var(--text);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .step-p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }

  .chat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .chat-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .chat-who {
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--faint);
    padding: 0 0.75rem;
  }

  .chat-bubble {
    font-size: 0.875rem;
    line-height: 1.55;
    padding: 0.625rem 0.875rem;
    border-radius: 10px;
    max-width: 90%;
  }

  .chat-user .chat-bubble {
    background: var(--bg-subtle);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 3px;
    align-self: flex-start;
  }

  .chat-ai .chat-bubble {
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-bottom-left-radius: 3px;
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .step {
      padding: 1.75rem 0;
      border-top: 1px solid var(--border);
    }
    .step:last-child { border-bottom: 1px solid var(--border); }
  }
</style>
