---
import { useTranslations } from '../i18n/utils';
import { type Lang, defaultLang } from '../i18n/ui';
const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---
<section class="section" id="campaigns" aria-labelledby="camp-heading">
  <div class="container">
    <p class="label reveal">{t('camp.label')}</p>
    <h2 class="section-h2 reveal reveal-delay-1" id="camp-heading">
      {t('camp.heading')}<br /><em>{t('camp.heading-em')}</em>
    </h2>

    <div class="camp-grid reveal reveal-delay-2">
      <div class="camp-col">
        <h3 class="camp-h3">{t('camp.campaigns-title')}</h3>
        <p class="camp-p">{t('camp.campaigns-desc')}</p>
      </div>
      <div class="camp-col">
        <h3 class="camp-h3">{t('camp.board-title')}</h3>
        <p class="camp-p">{t('camp.board-desc')}</p>
      </div>
      <div class="camp-col">
        <h3 class="camp-h3">{t('camp.calendar-title')}</h3>
        <p class="camp-p">{t('camp.calendar-desc')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .camp-grid {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .camp-col {
    padding: 0;
  }

  .camp-h3 {
    font-family: var(--serif);
    font-size: 1.125rem;
    font-weight: 500;
    font-optical-sizing: auto;
    color: var(--text);
    margin-bottom: 0.75rem;
    line-height: 1.3;
  }

  .camp-p {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .camp-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
