---
import { useTranslations } from '../i18n/utils';
import { type Lang, defaultLang } from '../i18n/ui';
import { DOWNLOAD_URLS } from '../constants';
const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = useTranslations(lang);
---
<section class="section" id="install" aria-labelledby="install-heading">
  <div class="container">
    <p class="label reveal">{t('install.label')}</p>
    <h2 class="section-h2 reveal reveal-delay-1" id="install-heading">
      {t('install.heading')}<br /><em>{t('install.heading-em')}</em>
    </h2>

    <div class="install-split reveal reveal-delay-2">
      <div class="install-left" data-install-tabs>
        <div class="install-tabs-side" role="tablist" aria-label="Platform">
          <div class="install-tab is-active" role="tab" data-os="mac" aria-selected="true" tabindex="0">{t('install.macos-tab')}</div>
          <div class="install-tab" role="tab" data-os="windows" aria-selected="false" tabindex="-1">{t('install.windows-tab')}</div>
          <div class="install-tab" role="tab" data-os="npx" aria-selected="false" tabindex="-1">{t('install.npx-tab')}</div>
        </div>

        <div class="install-panels">
          <div class="install-panel is-active" data-panel="mac">
            <a href={DOWNLOAD_URLS.macosDmg} class="btn btn-primary">
              {t('install.macos-cta')}
            </a>
            <p class="install-note" set:html={t('install.macos-note')} />
          </div>

          <div class="install-panel" data-panel="windows">
            <a href={DOWNLOAD_URLS.windowsExe} class="btn btn-primary">
              {t('install.windows-cta')}
            </a>
          </div>

          <div class="install-panel" data-panel="npx">
            <div class="install-code-block">
              <code>{t('install.npx-command')}</code>
              <button class="install-copy-btn" data-copy={t('install.npx-command')} data-copied-label={t('install.copied-label')} aria-label={t('install.copy-command')}>
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                  <rect x="4" y="4" width="11" height="11" rx="1.5" stroke="currentColor" stroke-width="1.2"/>
                  <path d="M1 12V2.5A1.5 1.5 0 012.5 1H12" stroke="currentColor" stroke-width="1.2"/>
                </svg>
              </button>
            </div>
            <p class="install-note" set:html={t('install.npx-note')} />
          </div>
        </div>
      </div>

      <div class="install-right">
        <ol class="install-steps">
          <li>
            <span class="install-num">1</span>
            <div>
              <strong>{t('install.step-1-title')}</strong>
              <span class="install-detail">{t('install.step-1-detail')}</span>
            </div>
          </li>
          <li>
            <span class="install-num">2</span>
            <div>
              <strong>{t('install.step-2-title')}</strong>
              <span class="install-detail">{t('install.step-2-detail')}</span>
            </div>
          </li>
          <li>
            <span class="install-num">3</span>
            <div>
              <strong>{t('install.step-3-title')}</strong>
              <span class="install-detail">{t('install.step-3-detail')}</span>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  (function() {
    const tabs = document.querySelectorAll('[data-install-tabs] .install-tab');
    const panels = document.querySelectorAll('[data-panel]');

    const osMap = { 'Mac': 'mac', 'Win': 'windows' };
    let detected = 'mac';
    for (const [key, val] of Object.entries(osMap)) {
      if (navigator.userAgent.includes(key)) { detected = val; break; }
    }

    tabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); (t as HTMLElement).tabIndex = -1; });
    panels.forEach(p => p.classList.remove('is-active'));
    const dTab = document.querySelector(`[data-install-tabs] .install-tab[data-os="${detected}"]`) as HTMLElement | null;
    const dPanel = document.querySelector(`[data-panel="${detected}"]`);
    if (dTab && dPanel) {
      dTab.classList.add('is-active');
      dTab.setAttribute('aria-selected', 'true');
      dTab.tabIndex = 0;
      dPanel.classList.add('is-active');
    }

    tabs.forEach(tab => {
      const activate = () => {
        const os = (tab as HTMLElement).dataset.os;
        tabs.forEach(t => { t.classList.remove('is-active'); t.setAttribute('aria-selected', 'false'); (t as HTMLElement).tabIndex = -1; });
        panels.forEach(p => p.classList.remove('is-active'));
        tab.classList.add('is-active');
        tab.setAttribute('aria-selected', 'true');
        (tab as HTMLElement).tabIndex = 0;
        const panel = document.querySelector(`[data-panel="${os}"]`);
        if (panel) panel.classList.add('is-active');
      };
      tab.addEventListener('click', activate);
      tab.addEventListener('keydown', (e: Event) => {
        const ke = e as KeyboardEvent;
        if (ke.key === 'Enter' || ke.key === ' ') { ke.preventDefault(); activate(); }
      });
    });

    document.querySelectorAll('[data-copy]').forEach(btn => {
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText((btn as HTMLElement).dataset.copy ?? '');
          const orig = btn.innerHTML;
          const label = (btn as HTMLElement).dataset.copiedLabel ?? 'Copied!';
          btn.innerHTML = '<span style="color: var(--green); font-size:0.75rem;">' + label + '</span>';
          setTimeout(() => { btn.innerHTML = orig; }, 1500);
        } catch { /* clipboard not available */ }
      });
    });
  })();
</script>

<style>
  .install-split {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  .install-tabs-side {
    display: flex;
    gap: 0.25rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .install-tab {
    padding: 0.4rem 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s;
    user-select: none;
    outline: none;
    position: relative;
    margin-right: 1.25rem;
  }

  .install-tab::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: transparent;
    transition: background-color 0.2s;
    border-radius: 1px;
  }

  .install-tab:hover { color: var(--text); }
  .install-tab.is-active { color: var(--accent); }
  .install-tab.is-active::after { background: var(--accent); }

  .install-panel { display: none; }

  .install-panel.is-active { display: flex; flex-direction: column; gap: 1rem; align-items: flex-start; }

  .install-code-block {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 0.85rem 1rem;
    width: 100%;
    max-width: 100%;
  }

  .install-code-block code {
    font-family: var(--mono);
    font-size: 0.8125rem;
    color: var(--text);
    flex: 1;
    overflow-x: auto;
    white-space: pre;
  }

  .install-copy-btn {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .install-copy-btn:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .install-note {
    font-size: 0.8125rem;
    color: var(--faint);
    line-height: 1.5;
  }

  .install-note strong { color: var(--text); font-weight: 500; }

  .install-right {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .install-steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .install-steps li {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border);
  }

  .install-steps li:first-child { border-top: none; }
  .install-steps li:last-child { border-bottom: 1px solid var(--border); }

  .install-num {
    flex-shrink: 0;
    width: 1.75rem;
    height: 1.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--muted);
    margin-top: 0.1rem;
  }

  .install-steps strong {
    display: block;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text);
    margin-bottom: 0.2rem;
  }

  .install-detail {
    font-size: 0.875rem;
    color: var(--muted);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .install-split { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
