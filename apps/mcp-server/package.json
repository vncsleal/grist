{
  "name": "@quillby/mcp",
  "version": "0.1.0",
  "mcpName": "io.github.quillby/mcp-server",
  "description": "Quillby — AI copywriting assistant. Reads the internet and writes content in your voice.",
  "license": "MIT",
  "author": "Vinicius Leal",
  "keywords": [
    "rss",
    "agents",
    "mcp",
    "ai",
    "content",
    "research",
    "typescript"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist/local/mcp/server.js",
  "bin": {
    "quillby-mcp": "bin/quillby-mcp"
  },
  "files": [
    "dist",
    "bin",
    "config",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @quillby/core --filter @quillby/config --filter @quillby/content --filter @quillby/auth --filter @quillby/workspace --filter @quillby/database --filter @quillby/billing --filter @quillby/storage-fs --filter @quillby/storage-db --filter @quillby/providers build",
    "prepare": "true",
    "mcp": "node dist/local/main.js",
    "mcp:dev": "tsx src/main.ts",
    "mcp:start": "node dist/local/main.js",
    "dev": "tsx src/main.ts",
    "clean": "rm -rf .cache dist drizzle coverage",
"build": "tsc -p tsconfig.local.json",
"build:local": "tsc -p tsconfig.local.json",
    "build:cloud": "tsc -p tsconfig.cloud.json",
    "build:selfhosted": "tsc -p tsconfig.selfhosted.json",
    "lint": "eslint .",
    "build:binaries": "bun build --compile --target=bun-darwin-arm64 ./src/main-local.ts --outfile quillby-mcp-macos-arm64 && bun build --compile --target=bun-darwin-x64 ./src/main-local.ts --outfile quillby-mcp-macos-x64 && bun build --compile --target=bun-linux-x64 ./src/main-local.ts --outfile quillby-mcp-linux-x64 && bun build --compile --target=bun-windows-x64 ./src/main-local.ts --outfile quillby-mcp-windows-x64.exe",
    "typecheck": "tsc --noEmit -p tsconfig.local.json",
    "test": "vitest run tests/unit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "pnpm run build && vitest run tests/integration/mcp-protocol.test.ts tests/integration/mcp-v2-smoke.test.ts",
    "test:all": "pnpm run test:unit && pnpm run test:integration",
    "db:push": "drizzle-kit push --config drizzle.config.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "keys": "tsx src/cli/keys.ts",
    "migrate": "tsx ../../tooling/scripts/migrate-local-to-hosted.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.5.6",
    "@better-fetch/fetch": "1.1.21",
    "@libsql/client": "0.17.2",
    "@modelcontextprotocol/ext-apps": "1.2.2",
    "@modelcontextprotocol/sdk": "1.9.0",
    "@mozilla/readability": "0.6.0",
    "@opentelemetry/api": "1.9.0",
    "better-auth": "1.5.6",
    "better-call": "1.3.2",
    "chalk": "5.6.2",
    "dotenv": "16.4.5",
    "drizzle-orm": "0.45.2",
    "jose": "6.1.3",
    "kysely": "0.28.8",
    "linkedom": "0.18.12",
    "nanostores": "1.1.0",
    "nodemailer": "8.0.9",
    "rss-parser": "3.13.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.1"
  },
  "devDependencies": {
    "@quillby/auth": "workspace:*",
    "@quillby/billing": "workspace:*",
    "@quillby/config": "workspace:*",
    "@quillby/content": "workspace:*",
    "@quillby/core": "workspace:*",
    "@quillby/database": "workspace:*",
    "@quillby/providers": "workspace:*",
    "@quillby/storage-db": "workspace:*",
    "@quillby/storage-fs": "workspace:*",
    "@quillby/workspace": "workspace:*",
    "@types/node": "20.11.24",
    "@types/nodemailer": "8.0.0",
    "@vitest/coverage-v8": "4.1.7",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.25.2",
    "tsx": "4.7.2",
    "typescript": "5.8.3",
    "vitest": "4.1.0"
  }
}
