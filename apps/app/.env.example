# ─── Quillby App (apps/app) ───────────────────────────────────────────────────
# Copy to .env.local and fill in values before running `pnpm dev` or building.

# Base URL of the Quillby HTTP server that this app talks to.
# - Local dev against a local server: leave as default (http://localhost:3000)
# - Cloud deployment: set to your public server domain (https://api.yourapp.com)
# - Self-hosted deployment: set to the self-hosted server URL
# Must NOT have a trailing slash.
VITE_QUILLBY_API_BASE_URL=http://localhost:3000

# Deployment mode — baked into the SPA bundle at build time.
# When set, the Home screen skips the manual picker and redirects directly
# to the correct auth flow. Leave unset for local dev (picker is shown).
#   cloud        → redirects to /cloud (email + password auth)
#   self-hosted  → redirects to /connect/self-hosted (server URL + API key)
VITE_QUILLBY_DEPLOYMENT_MODE=
