{
  "name": "@quillby/storage-db",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "vitest": "4.1.0",
    "@vitest/coverage-v8": "4.1.7"
  },
  "dependencies": {
    "@quillby/billing": "workspace:*",
    "@quillby/content": "workspace:*",
    "@quillby/core": "workspace:*",
    "@quillby/database": "workspace:*",
    "@quillby/workspace": "workspace:*",
    "drizzle-orm": "0.45.2"
  }
}
