# Quillby runtime
QUILLBY_HOME=~/.quillby

# Transport: stdio (default) or http
QUILLBY_TRANSPORT=stdio
PORT=3000
QUILLBY_HTTP_HOST=0.0.0.0
QUILLBY_BASE_URL=http://localhost:3000

# Better Auth / libSQL (local default)
QUILLBY_AUTH_DB_URL=file:./quillby-auth.db
# For remote libSQL/Turso only
LIBSQL_AUTH_TOKEN=

# Better Auth base URL (recommended in HTTP mode)
BETTER_AUTH_URL=http://localhost:3000
# Required in HTTP mode — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Default per-key API rate limit (requests per minute)
QUILLBY_RATE_LIMIT=60

# ── provider keys (optional — can also be configured via Settings UI) ──
# QUILLBY_REPLICATE_API_TOKEN=     # Single token unlocks image+audio+video via Replicate
# QUILLBY_REPLICATE_IMAGE_MODEL=   # Default: black-forest-labs/flux-2-pro
# QUILLBY_REPLICATE_AUDIO_MODEL=   # Default: minimax/speech-2.8-turbo
# QUILLBY_REPLICATE_VIDEO_MODEL=   # Default: runwayml/gen-4.5
# QUILLBY_REPLICATE_CLONE_AUDIO_MODEL=  # Default: eleven-labs/flash-2
# QUILLBY_REPLICATE_CLONE_VIDEO_MODEL=  # Default: tencent/hunyuan-video-latent
# QUILLBY_OPENAI_API_KEY=          # For GPT-Image generation
# QUILLBY_BFL_API_KEY=             # For Black Forest Labs Flux
# QUILLBY_ELEVENLABS_API_KEY=      # For ElevenLabs TTS + voice cloning
# QUILLBY_ELEVENLABS_DEFAULT_VOICE_ID=
# QUILLBY_MINIMAX_API_KEY=         # For MiniMax TTS
# QUILLBY_MINIMAX_GROUP_ID=
# QUILLBY_GOOGLE_AI_API_KEY=       # For Google Veo video generation
# QUILLBY_FAL_API_KEY=             # For fal.ai Kling video generation
#
# ── provider config security (local/self-hosted) ──
# QUILLBY_PROVIDER_ENCRYPTION_KEY= # Required for self-hosted provider config in Settings UI. Generate: openssl rand -base64 32
# QUILLBY_KEYRING_SECRET=          # Fallback for local mode on non-macOS
#
# ── Stripe billing (cloud mode only) ──
# QUILLBY_ENFORCE_PLAN_LIMITS=1    # Enable plan enforcement (default: true in cloud mode)
# QUILLBY_STRIPE_CHECKOUT_URL_PRO= # Stripe Checkout Session URL for Pro plan
# QUILLBY_STRIPE_WEBHOOK_SECRET=   # Stripe webhook signing secret (whsec_...)
# QUILLBY_STRIPE_PRO_PRICE_ID=     # Stripe Price ID for the Pro subscription
# QUILLBY_CLOUD_BILLING_PORTAL_URL= # Stripe Customer Portal URL for plan management
